NODE_ENV=development
PORT=5000

FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:5000

MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/oneearthlegacy?retryWrites=true&w=majority

JWT_ACCESS_SECRET=replace_with_long_random_access_secret
JWT_REFRESH_SECRET=replace_with_long_random_refresh_secret
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

GOOGLE_CLIENT_ID=temporary_later

RESEND_API_KEY=temporary_later
EMAIL_FROM=One Earth Legacy <noreply@onearthlegacy.com>

COOKIE_DOMAIN=localhost

# Stripe checkout + webhook
# Local development:
# 1. Use STRIPE_SECRET_KEY starting with sk_test_
# 2. Run Stripe CLI webhook forwarding:
#    stripe listen --forward-to localhost:5000/api/payments/stripe/webhook
# 3. Copy the whsec_ value from Stripe CLI into STRIPE_WEBHOOK_SECRET
# 4. Keep success/cancel URLs pointed to localhost while testing
#
# Production:
# 1. Change NODE_ENV=production
# 2. Use STRIPE_SECRET_KEY starting with sk_live_
# 3. Use the live webhook endpoint secret from Stripe Dashboard
# 4. Change STRIPE_SUCCESS_URL and STRIPE_CANCEL_URL to your production domain
# 5. Test one small live payment before public launch
STRIPE_SECRET_KEY=sk_test_replace_with_your_test_secret_key
STRIPE_WEBHOOK_SECRET=whsec_replace_with_your_local_webhook_secret
STRIPE_SUCCESS_URL=http://localhost:5173/donate/success
STRIPE_CANCEL_URL=http://localhost:5173/donate

CLOUDINARY_CLOUD_NAME=temporary_later
CLOUDINARY_API_KEY=temporary_later
CLOUDINARY_API_SECRET=temporary_later

# Admin IP allowlist
# Keep disabled until production admin security is ready.
ADMIN_IP_ALLOWLIST_ENABLED=false

# Comma-separated IPs when enabled.
# Example: ADMIN_ALLOWED_IPS=123.123.123.123,111.111.111.111
ADMIN_ALLOWED_IPS=

# Admin 2FA preparation
# Keep false until the 2FA setup and verification routes are fully implemented.
ADMIN_2FA_REQUIRED=false
